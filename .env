# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
APP_NAME=MonitorIQ
API_VERSION=v1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL Connection String
DATABASE_URL=postgresql://admin:postgres_password_change_me@localhost:5432/monitoriq?schema=public

# Connection Pool Settings
DB_POOL_MIN=5
DB_POOL_MAX=20

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL Settings (seconds)
REDIS_API_STATUS_TTL=120
REDIS_DASHBOARD_CACHE_TTL=30

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=monitoriq-service
KAFKA_INCIDENT_TOPIC=incident-events
KAFKA_CONSUMER_GROUP=incident-processor-group

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=edacb3a8f97a5de465de4abb938ff1c194b63a8df0d93493a223d113f8cb22f0f266061d0ed7d814d60a5006b3b862a9dca0070499f56540802e38420caf0f9f
JWT_EXPIRY=24h
BCRYPT_SALT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ============================================
# MONITORING ENGINE CONFIGURATION
# ============================================
MONITORING_DEFAULT_INTERVAL=60
MONITORING_CONCURRENCY_LIMIT=10
MONITORING_DEFAULT_TIMEOUT=5000
INCIDENT_FAILURE_THRESHOLD=3

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
AI_PROVIDER=mock
AI_ENABLED=true

# OpenAI Configuration
OPENAI_API_KEY=CHANGEME_AI_API_KEY
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.3

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
EMAIL_PROVIDER=mock
EMAIL_HOST=CHANGEME_SMTP_HOST
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=CHANGEME_SMTP_USER
EMAIL_PASSWORD=CHANGEME_SMTP_PASSWORD
EMAIL_FROM_NAME=MonitorIQ Alert System
EMAIL_FROM_ADDRESS=CHANGEME_ALERT_EMAIL_FROM
ALERT_EMAIL_TO=alerts@example.invalid

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ANALYSIS=true
FEATURE_EMAIL_ALERTS=true
FEATURE_KAFKA_EVENTS=true
FEATURE_REDIS_CACHE=true
